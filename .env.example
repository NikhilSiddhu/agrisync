# Copy this file to .env and fill it in.  .env is gitignored - never commit it.

# --- database ---
# Local Docker Mongo (recommended, works with no internet):
MONGO_URI=mongodb://localhost:27017/agrisync
# Or a MongoDB Atlas string if you are mirroring to the cloud:
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/agrisync

# --- device auth ---
# Any long random string. The ESP32 firmware must send the EXACT same value
# or every POST comes back 401. Generate one with:  openssl rand -hex 16
DEVICE_API_KEY=change-me-before-you-flash-anything

# --- site ---
SITE_NAME=Hapur
SITE_LAT=28.7170
SITE_LON=77.7740
SITE_TZ=Asia/Kolkata

# --- flask ---
FLASK_PORT=5000

# --- alerting (all optional, all free) ---
# How long a device may go quiet before the watchdog calls it stale.
ALERT_STALE_MINUTES=30

# ntfy.sh is the quickest: pick an unguessable topic, install the ntfy phone
# app, subscribe. No signup, no card. Slack and Discord webhooks also work.
ALERT_WEBHOOK_URL=

# Or Telegram. Message @BotFather to create a bot and get the token, then
# message your bot once and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Disease-odds alerts (src/alerts.py) use the same channel. One goes out when
# the next 48 h turn HIGH and at least half of the 51 weather runs agree, then
# at most one reminder a day. The older per-disease rule, used only when the
# odds are missing or over 3 h old, skips downy mildew and black rot (their
# thresholds are estimates) unless this is 1.
ALERT_ESTIMATED=0

# --- read access (optional) ---
# Leave EMPTY on a trusted home LAN. SET IT before you expose the API through
# a Cloudflare tunnel or a port forward, otherwise anyone with the URL can
# read your whole dataset.
#   openssl rand -hex 16
READ_API_KEY=

# --- bind address ---
# 0.0.0.0 lets the ESP32 reach the API over WiFi.
# Change to 127.0.0.1 once cloudflared is running, so the tunnel is the only
# way in and nothing else on your network can touch it.
BIND_HOST=0.0.0.0

# --- Cloudflare Access identity (optional but recommended) ---
# Lets the app see WHO signed in, so visitors can be recorded, without the app
# ever handling a password or sending an email.
#
# Team domain: your Zero Trust team name plus .cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=agrisynctech.cloudflareaccess.com
#
# Application Audience (AUD) tag. Zero Trust -> Access -> Applications ->
# your app -> Overview. A long hex string.
CF_ACCESS_AUD=
#
# Who may open /admin/visitors. Comma separated. Empty means nobody.
ADMIN_EMAILS=nikhildsiddhu@outlook.com

# --- Phytoplex signing key (field build, firmware 1.5.0) ---
# Shared with the board, which gets the same value at build time as
# DEVICE_HMAC_SECRET. Generate a fresh one with:  openssl rand -hex 32
# Change it on the Pi and in the firmware build together, or every POST
# comes back 401.
DEVICE_HMAC_SECRET=

# --- disease odds ---
# The day the crop went into the field, YYYY-MM-DD. Sets the crop stage
# (nursery, establishing, leafy growth, head forming, mature). Leave empty
# and the first field-log visit marked "transplanted" is used; with neither,
# every stage is weighed evenly and the dashboard says so.
TRANSPLANT_DATE=
# How many past ERA5 seasons the odds are ranked against ("a bad night for
# this time of year").
CLIMATE_YEARS=20

# --- leaf wetness ---
# With no leaf sensor, leaf temperature is air temperature minus this many
# degrees Celsius. A cheap stand-in, not a measurement.
LEAF_TEMP_OFFSET_C=1.0
# Only once a leaf wetness sensor is fitted (firmware 1.5.0 built with
# -DLEAF_WET_SENSOR=1). Leave empty until you have both numbers.
#   LW_DRY_MV             what the sensor reads clean and dry, in millivolts
#   LW_WET_MV             what it reads misted until dripping
#   LW_WET_THRESHOLD_PCT  how far along dry-to-wet counts as wet. Dew covers
#                         only part of the surface, so this is well under 50.
LW_DRY_MV=
LW_WET_MV=
LW_WET_THRESHOLD_PCT=20
